{
  "name": "my-brush",
  "productName": "My Brush",
  "version": "0.2.2",
  "description": "macOS와 Windows용 화면 필기 오버레이",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "node node_modules/electron/install.js",
    "test:electron": "node scripts/verify-electron.cjs",
    "test:pointer": "node scripts/verify-pointer-input.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "dev.mybrush.desktop",
    "productName": "My Brush",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
